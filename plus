import sys

def tsum(line):
    try:
        return int(line)
    except ValueError:
        return float(line)

x = 0
count = 0

try:
    for line in sys.stdin:
        x += tsum(line)
        count += 1

    if count == 0:
        sys.exit(1)

except ValueError:
    sys.exit(1)

print(x)
