import sys
import math

if len(sys.argv) != 2:
    print("Usage: deadband THRESHOLD", file=sys.stderr)
    sys.exit(1)

try:
    threshold = float(sys.argv[1])
    if not math.isfinite(threshold) or threshold < 0:
        raise ValueError
except ValueError:
    print("Error: THRESHOLD must be a non-negative number", file=sys.stderr)
    sys.exit(1)

try:
    for line in sys.stdin:
        value = float(line)

        if not math.isfinite(value):
            raise ValueError

        if abs(value) < threshold:
            print(0)
        else:
            print(value)

except ValueError:
    print("Error: input must contain only finite numbers", file=sys.stderr)
    sys.exit(1)
